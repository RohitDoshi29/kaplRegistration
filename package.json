{
  "name": "player-registration-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:prod": "wrangler deploy --env production",
    "worker:migrate": "wrangler d1 migrations apply player-portal --remote",
    "worker:seed": "wrangler d1 execute player-portal --remote --file=./scripts/seed.sql",
    "worker:tail": "wrangler tail",
    "db:create": "wrangler d1 create player-portal",
    "db:list": "wrangler d1 list",
    "db:backup": "wrangler d1 export player-portal > backup.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "@cloudflare/workers-types": "^4.20240530.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wrangler": "^3.30.0"
  }
}
